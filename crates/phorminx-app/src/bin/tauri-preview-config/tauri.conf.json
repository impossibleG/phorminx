{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phorminx",
  "version": "0.1.0",
  "identifier": "net.phorminx.preview",
  "build": { "frontendDist": "../../../../../design" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phorminx · Tauri architecture preview",
        "url": "tauri-preview/index.html",
        "width": 980,
        "height": 720,
        "minWidth": 430,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../../../design/brand/phorminx.ico"]
  }
}
