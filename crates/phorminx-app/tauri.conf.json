{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phorminx",
  "version": "0.1.0",
  "identifier": "net.phorminx.app",
  "build": {
    "frontendDist": "../../design"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phorminx",
        "url": "tauri-preview/product.html",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../design/brand/phorminx.ico"]
  }
}
